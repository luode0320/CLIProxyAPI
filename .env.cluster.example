# Cluster JWT example.
# After deploying https://github.com/router-for-me/CLIProxyAPIHome, get the JWT value with:
# curl -sS -X POST "http://<home-host>:8327/v0/management/certificates/clients" -H "X-MANAGEMENT-KEY: <management-key>" | jq -r '.home_jwt'
# Then paste it into HOME_JWT here or export it before starting Compose.
HOME_JWT=your-home-jwt-here

# ------------------------------------------------------------------------------
# Docker Compose Volume Paths (cluster mode, persistence)
# ------------------------------------------------------------------------------
# CLI_PROXY_HOME_PATH: host dir mounted to /root/.cli-proxy-api (node auth data)
#   Default: ./home
# CLI_PROXY_LOG_PATH: host dir mounted to /CLIProxyAPI/logs (runtime logs)
#   Default: ./logs
# CLI_PROXY_PLUGIN_PATH: host dir mounted to /CLIProxyAPI/plugins (plugin binaries)
#   Plugins are installed at runtime into <dir>/<GOOS>/<GOARCH>/<id>-v<version>.so.
#   Default: ./plugins
#
# Production: use ABSOLUTE paths so re-deploys from a different working directory
# (CI clones, new folders) do not silently point at empty directories and lose data.
#   CLI_PROXY_HOME_PATH=/opt/cli-proxy-api/home
#   CLI_PROXY_LOG_PATH=/opt/cli-proxy-api/logs
#   CLI_PROXY_PLUGIN_PATH=/opt/cli-proxy-api/plugins
